{
  "name": "local-diffe-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && tsc -p tsconfig.lint.json",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node tests/review-navigation.browser.mjs",
    "build": "tsc -b && vite build",
    "build:profile": "tsc -b && vite build --mode profile",
    "preview": "vite preview",
    "preview:profile": "vite preview --mode profile"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "1.40.0",
    "react": "19.3.0",
    "react-arborist": "3.16.0",
    "react-dom": "19.3.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.87.0",
    "rustwright": "0.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "packageManager": "bun@1.4.4"
}
